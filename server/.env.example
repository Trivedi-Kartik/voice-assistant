# Groq (shared key used for free-tier/waitlist users who haven't added their own BYOK key)
GROQ_API_KEY=your_groq_key_here

# Postgres (Neon) - use the pooled connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Upstash Redis (ephemeral session buffer + rate-limit counters) - Upstash requires
# TLS, so this MUST be rediss:// not redis://
REDIS_URL=rediss://default:password@host:port

# Auth secrets
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# AES-256-GCM key (32 raw bytes, base64-encoded) used to encrypt each user's BYOK Groq key at rest
BYOK_ENCRYPTION_KEY=base64_encoded_32_byte_key

# Per-user daily cap on the shared Groq key (lifted entirely once a user sets their own BYOK key)
DAILY_TURN_CAP=25

PORT=8080
