// Durable, relational data. As of Phase 2 (see ROADMAP.md), conversation
// transcripts and per-user preference memory ARE persisted here — this is an
// explicit, disclosed feature, not the v1 default (v1 kept transcripts ephemeral
// in Redis only). See docs/ARCHITECTURE.md for the full reasoning and what
// changed.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String   @map("password_hash")
  displayName     String?  @map("display_name")
  plan            String   @default("free") // 'free' | 'pro' (pro unused until billing exists)
  groqApiKeyEnc   Bytes?   @map("groq_api_key_enc") // AES-256-GCM ciphertext of user's own Groq key (BYOK)
  // One of the 8 languages Meta officially validated Llama 3.3 70B on — see
  // docs/ARCHITECTURE.md "Multi-language support". A personal, per-account
  // preference (follows the user across devices), same precedent as
  // groqApiKeyEnc above — NOT a Device-level field like platform/capabilities,
  // which describe hardware, not a person's preference.
  language        String   @default("en") @map("language")
  invitedAt       DateTime @default(now()) @map("invited_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  devices         Device[]
  refreshTokens   RefreshToken[]
  usageEvents     UsageEvent[]
  toolInvocations ToolInvocation[]
  conversations   Conversation[]
  memoryFacts     MemoryFact[]
  automationSteps AutomationStep[]

  @@map("users")
}

model Device {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String    @map("device_name")
  platform     String    // 'windows' | 'mac' | 'linux' | 'android' | 'ios'
  capabilities Json      @default("[]") // tool names this device's client actually implements
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  refreshTokens   RefreshToken[]
  toolInvocations ToolInvocation[]

  @@map("devices")
}

model RefreshToken {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String        @map("device_id")
  device        Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenHash     String        @map("token_hash") // sha256 of the raw token — raw token never stored
  replacedById  String?       @unique @map("replaced_by_id")
  replacedBy    RefreshToken? @relation("TokenChain", fields: [replacedById], references: [id])
  replacedFrom  RefreshToken? @relation("TokenChain")
  expiresAt     DateTime      @map("expires_at")
  revokedAt     DateTime?     @map("revoked_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// Per-user/day usage counters — backs the shared-key daily cap (lifted once BYOK is set).
model UsageEvent {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day            DateTime @db.Date
  groqSttSeconds Int      @default(0) @map("groq_stt_seconds")
  groqTokensIn   Int      @default(0) @map("groq_llm_tokens_in")
  groqTokensOut  Int      @default(0) @map("groq_llm_tokens_out")
  turnCount      Int      @default(0) @map("turn_count")

  @@unique([userId, day])
  @@map("usage_events")
}

// Audit trail of real OS actions taken on a user's machine — deliberately does NOT
// include conversation transcript content, only the structured tool call/result.
model ToolInvocation {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String    @map("device_id")
  device      Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  toolName    String    @map("tool_name")
  args        Json
  result      Json?
  status      String    @default("pending") // 'pending' | 'success' | 'error' | 'timeout'
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([userId, createdAt])
  @@map("tool_invocations")
}

// A durable conversation thread — replaces the v1 ephemeral-only Redis buffer.
// Redis (see redis.ts) is still used as a short-TTL cache for the in-flight
// session's working history so a live turn doesn't round-trip Postgres on every
// message; this table is the durable record that survives reconnects, app
// restarts, and lets memory (below) be extracted from real history.
model Conversation {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String?   @map("device_id") // metadata about where it started — NOT a partition boundary
  title        String?
  startedAt    DateTime  @default(now()) @map("started_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  archived     Boolean   @default(false)

  messages Message[]

  @@index([userId, lastActiveAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // 'system' | 'user' | 'assistant' | 'tool'
  content        String       @db.Text
  toolName       String?      @map("tool_name")
  toolCallId     String?      @map("tool_call_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  memoryFacts MemoryFact[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Per-user preference memory (Phase 2) — e.g. "always search in Chrome, not
// Edge". Populated only when the assistant explicitly calls the
// remember_preference tool (server-handled, see tools/schemas.ts and
// ws/session.ts) — never by passively/automatically scanning conversations,
// which would be much harder to make predictable or explain to a user.
// `embedding` is Prisma's `Unsupported` type: Prisma Client can't generate typed
// accessors for pgvector's `vector` type, so all reads/writes to this column go
// through raw SQL (see memory/memoryStore.ts) — the column still exists and is
// indexed like any other, just not through the generated Client API.
model MemoryFact {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  factText        String    @map("fact_text") @db.Text
  embedding       Unsupported("vector(384)")?
  sourceMessageId String?   @map("source_message_id")
  sourceMessage   Message?  @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now()) @map("created_at")
  lastUsedAt      DateTime? @map("last_used_at")

  @@index([userId])
  @@map("memory_facts")
}

// Audit trail for computer-use automation (see server/src/automation/) — one
// row per EXECUTED step (a proposed-but-not-yet-confirmed high-risk step is
// never written here, only what actually ran). Modeled after ToolInvocation,
// with an added ordering concept since a task is a sequence, not a single
// call. Deliberately excludes screenshot bytes, same reasoning as
// ToolInvocation excluding transcript content and vision/routes.ts not
// persisting screen-content data anywhere.
model AutomationStep {
  id            String   @id @default(uuid())
  taskId        String   @map("task_id")
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String   @map("device_id")
  stepIndex     Int      @map("step_index")
  action        Json // the decided AutomationAction (type/x/y/text/key/risk/reasoning) — never a screenshot
  risk          String // 'low' | 'high'
  confirmed     Boolean  @default(false)
  resultOk      Boolean? @map("result_ok")
  resultMessage String?  @map("result_message") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@index([userId, createdAt])
  @@map("automation_steps")
}
